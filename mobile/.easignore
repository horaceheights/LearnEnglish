# EAS discovers this file beside mobile/package.json, but archives from the
# Git repository root. Keep every pattern relative to that archive root.
.agents/
.codex-remote-attachments/
.git/
.streamlit/
backend/
frontend/
Lessons/
scripts/
tmp/
venv/
__pycache__/

# Root-level legacy app, deployment files, documentation, and local logs.
app.py
models.py
render.yaml
*.md
*.log
*.err.log
/package-lock.json

# Dependencies and local development state are recreated by EAS.
mobile/node_modules/
mobile/.expo/
mobile/.claude/
mobile/.codex-export-check/
mobile/.codex-translation-check/
mobile/.metro-health-check*
mobile/expo-local*.log
mobile/.eas-build-*.log

# Local diagnostic and generated output.
mobile/tmp-export-debug*/
mobile/eas-archive-inspect*/
mobile/dist/
mobile/dist*/
mobile/eas-archive*/
mobile/tmp-apk-size-audit/
mobile/web-build/
mobile/android/
mobile/ios/
mobile/.kotlin/
mobile/*.tsbuildinfo

# Store artwork is not part of the installed app.
mobile/assets/play-store/
mobile/assets/play-store-*.png

# Local secrets, credentials, and OS files.
mobile/.env
mobile/.env.*
mobile/*.jks
mobile/*.p8
mobile/*.p12
mobile/*.key
mobile/*.mobileprovision
mobile/.DS_Store
mobile/Thumbs.db
