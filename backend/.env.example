SPEECHACE_API_KEY=replace-with-your-speechace-product-key
SPEECHACE_API_BASE_URL=https://api.speechace.co
SPEECHACE_DIALECT=en-us
# Leave APP_API_KEY empty until every active client release sends the matching key.
APP_API_KEY=
# Server-only. Never commit the real value or expose it through a public build variable.
ADMIN_API_KEY=
PRONUNCIATION_PROVIDER=azure
AZURE_SPEECH_KEY=replace-with-your-azure-speech-key
AZURE_SPEECH_REGION=mexicocentral
AZURE_SPEECH_LOCALE=en-US
AZURE_TTS_VOICE=en-US-JennyNeural
PRONUNCIATION_PEDAGOGICAL_SCORING=true
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_QUESTION_VOICE=alloy
OPENAI_TTS_ANSWER_VOICE=coral
OPENAI_TTS_FORMAT=mp3
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_BUILTIN_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
